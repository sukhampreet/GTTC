# Copy this file to `.env` in the same directory and fill in real values.
# NEVER commit the real .env file (it is already in .gitignore).

# --- Service ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SERVICE_NAME=gttc-backend

# --- CORS (comma-separated origins the frontend runs on) ---
CORS_ORIGINS=http://localhost:5173

# --- CP PLUS NVR / RTSP ---
NVR_HOST=192.168.1.245
NVR_RTSP_PORT=554
NVR_USERNAME=admin
NVR_PASSWORD=Admin@123
NVR_CHANNEL=1
# 0 = main stream, 1 = sub stream
NVR_STREAM_TYPE=1
NVR_MODEL=CP-UNR-108F1

# --- Camera registry ---
# Where added cameras (POST /api/cameras) are persisted so they survive a
# restart. Only used to seed Channel 1 from the NVR_* vars above the first
# time this file doesn't exist yet.
CAMERA_REGISTRY_PATH=app/data/cameras.json

# --- FFmpeg / HLS ---
# Bare command if ffmpeg is on PATH, or a full path e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
# x264 preset for the live transcode. "veryfast" is the safe default;
# "ultrafast" trims a bit more latency at a real quality/bitrate cost.
FFMPEG_PRESET=veryfast
STREAM_DIRECTORY=streams
HLS_SEGMENT_SECONDS=1
HLS_LIST_SIZE=3
HLS_STARTUP_TIMEOUT_SECONDS=8
STREAM_IDLE_TIMEOUT_SECONDS=120
